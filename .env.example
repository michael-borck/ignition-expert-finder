# Copy to .env and fill in. .env is gitignored - never commit real values.

# --- Inference -------------------------------------------------------------
# Remote Ollama endpoint. gemma4:12b is multimodal and preloaded into VRAM at
# the other end, so it handles both the text and the slide-image paths. Do not
# introduce a second model: switching would evict it and stall every request.
OLLAMA_BASE_URL=https://your-ollama-host
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:12b

# Thinking is on by default and dominates latency. The app sets it per call
# rather than globally: chat turns run with thinking OFF (~3s, streamed, feels
# instant), and the single final extraction runs with thinking ON (~44s) because
# with it off the weakest-three areas stopped agreeing across identical runs -
# and that ranking is what chooses the experts. Ollama native API, "think" field
# on /api/chat; the OpenAI-compatible route uses reasoning_effort instead.

# Seconds to wait on a generation. Slide-image extraction over a multi-page
# deck is the slow path; the UI streams so the user sees progress meanwhile.
OLLAMA_TIMEOUT=180

# --- App -------------------------------------------------------------------
# Not 3000: that is the default for much of the Node ecosystem and will
# collide with any other dev server on the same machine.
PORT=3210

# SQLite event log. Mount this path as a Docker volume or the data dies with
# the container.
DATABASE_PATH=/data/expert-finder.sqlite

# Password for /admin (bench re-upload, availability toggles, exports).
# Generate one: openssl rand -base64 24
ADMIN_PASSWORD=

# Shown above the upload control. Says what is actually true: the document is
# read by a model hosted on Curtin infrastructure, is held only in memory for
# as long as the analysis takes, and is never written to disk. Do not soften
# this to just "not stored" - founders are handing over commercially sensitive
# material and the brief hold during processing is part of the honest answer.
UPLOAD_DISCLAIMER=Your document is read by a private AI model running on Curtin infrastructure. It is held only while it is being analysed, is never saved, and never leaves Curtin.
